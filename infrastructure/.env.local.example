# OrderCloud marketplace setup for the accelerator.
# Copy to .env.local (gitignored) and fill in. Values can also come from real environment variables.

# OrderCloud API base URL for your region, WITHOUT the /v1 suffix (the SDK appends it)
OC_API_URL=https://australiaeast-sandbox.ordercloud.io

# Privileged "middleware" client used to authenticate this tool AND by apps/api.
# Needs roles: ApiClientAdmin, BuyerAdmin, BuyerUserAdmin, CatalogAdmin, WebhookAdmin, IntegrationEventAdmin, SecurityProfileAdmin
OC_MIDDLEWARE_CLIENT_ID=
OC_MIDDLEWARE_CLIENT_SECRET=

# Shared secret used to verify OrderCloud webhook / integration-event requests. Must match OC_HASH_KEY in apps/api.
OC_HASH_KEY=

# Public base URL of the deployed apps/api (Next.js). Leave blank to skip integration-event + webhook registration.
API_URL=

# Storefront — set OC_STOREFRONT_CLIENT_ID to reuse an existing client instead of creating a new one
OC_STOREFRONT_CLIENT_ID=
OC_STOREFRONT_SCOPE=Shopper MeAdmin
OC_STOREFRONT_CUSTOM_SCOPE=
OC_STOREFRONT_ALLOW_ANON=true

# Admin — set OC_ADMIN_CLIENT_ID to reuse an existing client instead of creating a new one
OC_ADMIN_CLIENT_ID=
OC_ADMIN_SCOPE=AdminAddressAdmin AdminUserAdmin AdminUserGroupAdmin ApprovalRuleAdmin BundleAdmin BuyerAdmin CatalogAdmin CategoryAdmin CostCenterAdmin CreditCardAdmin LocaleAdmin OrderAdmin PriceScheduleAdmin ProductAdmin PromotionAdmin SecurityProfileAdmin ShipmentAdmin SpendingAccountAdmin SupplierAddressAdmin SupplierAdmin SupplierUserAdmin SupplierUserGroupAdmin UserGroupAdmin
OC_ADMIN_CUSTOM_SCOPE=

# Optional: override the apps/ directory names that receive .env.local
STOREFRONT_DIR=auto
SHOP_DIR=shop
ADMIN_DIR=admin
