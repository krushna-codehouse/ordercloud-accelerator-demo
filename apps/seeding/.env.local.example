# Copy to .env.local (gitignored) and fill in.
# Used by the `scrape` command: the base URL the downloaded product images will be
# hosted at. The generated seed YAML references each image as <base>/<filename>, and
# the images themselves are saved to output/products/images/ for you to upload there.
# A --image-base-url CLI flag overrides this value.
PRODUCT_IMAGE_BASE_URL=https://your-host.example.com/products/images
