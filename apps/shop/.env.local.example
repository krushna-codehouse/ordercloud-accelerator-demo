# ── Helix storefront (apps/shop) environment ──────────────────────────────
# Copy to `.env.local` and fill in. These mirror the apps/storefront contract,
# so the infrastructure tool (`npm run seed` / `npm run env`) can generate them.

# Branding
VITE_APP_NAME="Helix"

# OrderCloud auth
VITE_APP_ORDERCLOUD_BASE_API_URL="https://api.ordercloud.io/v1"   # must include /v1
VITE_APP_ORDERCLOUD_CLIENT_ID=""                                  # storefront buyer client ID
VITE_APP_ORDERCLOUD_ALLOW_ANONYMOUS="true"                        # anonymous shopping for the demo

# OpenID Connect (optional — leave disabled for the demo)
VITE_APP_ORDERCLOUD_OPENIDCONNECT_ENABLED="false"
VITE_APP_ORDERCLOUD_OPENIDCONNECT_CONFIG_ID=""
VITE_APP_ORDERCLOUD_OPENIDCONNECT_ACCESS_TOKEN_QUERY_PARAM_NAME=""
VITE_APP_ORDERCLOUD_OPENIDCONNECT_REFRESH_TOKEN_QUERY_PARAM_NAME=""
VITE_APP_ORDERCLOUD_OPENIDCONNECT_IDP_ACCESS_TOKEN_QUERY_PARAM_NAME=""

# Feature flags
VITE_APP_ORDERCLOUD_MULTILOCATION_INVENTORY="false"
VITE_APP_ORDERCLOUD_AUTO_APPLY_PROMOS="true"

# Payment provider: STRIPE | CARD_CONNECT | PAYPAL | BLUESNAP
VITE_APP_PAYMENT_PROVIDER="STRIPE"
