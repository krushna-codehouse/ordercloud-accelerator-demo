# OrderCloud API endpoint for the region you're using, WITHOUT the /v1 suffix (oc-client.ts appends it)
OC_API_URL=https://australiaeast-sandbox.ordercloud.io

# Middleware client credentials (server-to-server, never exposed to browser)
OC_MIDDLEWARE_CLIENT_ID=
OC_MIDDLEWARE_CLIENT_SECRET=

# Shared secret used to verify incoming OrderCloud webhook signatures (x-oc-hash header)
OC_HASH_KEY=

# Fallback public key returned by GET /api/getiframecredentials while the payment integration is mocked
# (e.g. a Stripe test publishable key, pk_test_...). Never put a secret key here.
PAYMENT_IFRAME_PUBLIC_KEY=

# Buyer that new self-service accounts (personal + trade) are created under.
# Must be a buyer the storefront API client can log users into.
OC_BUYER_ID=auto-buyer

# Origin allowed to call this API directly from the browser (currently just /api/register).
# Set to your deployed storefront's origin in production instead of "*".
STOREFRONT_ORIGIN=*
